        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, exchange) (rate(md_exchange_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{exchange}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, exchange) (rate(md_exchange_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{exchange}}",
          "refId": "B",
          "range": true
        }
